PORT=5001

# ──────────────────────────────────────────────────────────────────────
# DATABASE (pick ONE option)
# ──────────────────────────────────────────────────────────────────────
# OPTION A  — Local MongoDB (recommended for dev: no DNS issues)
#             Install first: https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://127.0.0.1:27017/ethiou_portal

# OPTION B  — MongoDB Atlas (cloud). Get URI from Atlas UI:
#             Connect → Drivers → Node.js 4.0+ → copy the +srv string.
#             Then replace <password>, replace /test → /ethiou_portal
# MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.YOUR_HASH.mongodb.net/ethiou_portal?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────
# JWT signing secret  —  generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_64_CHAR_STRING_FROM_NODE

# Admin auto-granted to this email on register (comma-separated list allowed)
# IMPORTANT: Use YOUR real admin email(s) here. First user registered with
#            one of these emails will automatically be admin.
ADMIN_EMAILS=your_admin@email_here.com

# ──────────────────────────────────────────────────────────────────────
# AI / RAG SERVICES
# ──────────────────────────────────────────────────────────────────────
# Voyage AI embeddings  —  https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Google Gemini  —  https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
