# ── ETHIO UNIVERSITY PORTAL - ENVIRONMENT TEMPLATE ──────────────────────────

# Database Connection (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication Secrets & Settings
JWT_SECRET=your-secure-512-bit-jwt-secret-key
ADMIN_EMAILS=admin@ethiouni.edu.et

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost

# AI & RAG Service Keys
GEMINI_API_KEY=your_gemini_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Cloudinary Media Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
