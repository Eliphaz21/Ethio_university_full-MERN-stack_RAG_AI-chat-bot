# Environment Configuration Template for Ethio University Portal

# Application Port & Database Connection
PORT=5000
MONGO_URI=mongodb://mongodb:27017/ethiouni
NODE_ENV=production

# Authentication & Security Secrets
JWT_SECRET=change-this-to-a-strong-secret-key-min-32-chars
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
ADMIN_EMAILS=admin@ethiouni.edu.et,eliphazyab@gmail.com

# AI & RAG Embeddings Service Keys
GEMINI_API_KEY=your_gemini_api_key_here
VOYAGE_API_KEY=your_voyage_ai_api_key_here

# Cloudinary Media Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
